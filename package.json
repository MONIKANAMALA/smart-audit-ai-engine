{
  "name": "smartaudit",
  "version": "1.0.0",
  "description": "AI-Enriched Continuous Audit Pipeline",
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "server": "nodemon server/src/server.js",
    "client": "cd client && npm run dev",
    "seed": "node server/scripts/seed.js",
    "test": "jest --config server/jest.config.js --forceExit --detectOpenHandles",
    "build": "cd client && npm run build"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "mongoose": "^7.6.3"
  },
  "devDependencies": {
    "concurrently": "^8.2.2",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "supertest": "^6.3.3"
  }
}
